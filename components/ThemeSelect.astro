---
// Icon theme toggle for @shuttering/starlight — replaces Starlight's <select>
// with three icon buttons (light / auto / dark). Same options, same storage key
// (`starlight-theme`) and resolved `data-theme` behaviour, so it's a drop-in.
//
// Wire it in a consumer's astro.config:
//   starlight({ components: { ThemeSelect: '@shuttering/starlight/ThemeSelect.astro' } })
const t = Astro.locals.t;
const label = t ? t('themeSelect.accessibleLabel') : 'Select theme';
const opts = [
  { value: 'light', label: t ? t('themeSelect.light') : 'Light' },
  { value: 'auto', label: t ? t('themeSelect.auto') : 'Auto' },
  { value: 'dark', label: t ? t('themeSelect.dark') : 'Dark' },
];
---

<shuttering-theme-select>
  <fieldset aria-label={label}>
    {
      opts.map((o) => (
        <button type="button" data-theme-value={o.value} title={o.label} aria-label={o.label} aria-pressed="false">
          {o.value === 'light' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4" />
            </svg>
          )}
          {o.value === 'auto' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" />
              <path d="M8 21h8M12 17v4" />
            </svg>
          )}
          {o.value === 'dark' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
          )}
        </button>
      ))
    }
  </fieldset>
</shuttering-theme-select>

<script>
  type Theme = 'auto' | 'dark' | 'light';
  const storageKey = 'starlight-theme';
  const parse = (t: unknown): Theme =>
    t === 'auto' || t === 'dark' || t === 'light' ? t : 'auto';
  const load = (): Theme =>
    parse(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));
  const store = (t: Theme): void => {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, t === 'light' || t === 'dark' ? t : '');
    }
  };
  const systemScheme = (): 'light' | 'dark' =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  class ShutteringThemeSelect extends HTMLElement {
    #buttons: HTMLButtonElement[];
    constructor() {
      super();
      this.#buttons = [...this.querySelectorAll('button')];
      this.#apply(load());
      for (const b of this.#buttons) {
        b.addEventListener('click', () => this.#apply(parse(b.dataset.themeValue)));
      }
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
        if (load() === 'auto') this.#apply('auto');
      });
    }
    #apply(theme: Theme): void {
      document.documentElement.dataset.theme = theme === 'auto' ? systemScheme() : theme;
      store(theme);
      for (const b of this.#buttons) {
        b.setAttribute('aria-pressed', String(b.dataset.themeValue === theme));
      }
    }
  }
  customElements.define('shuttering-theme-select', ShutteringThemeSelect);
</script>

<style>
  fieldset {
    display: inline-flex;
    gap: 1px;
    margin: 0;
    padding: 2px;
    border: 0;
    border-radius: 7px;
    background: var(--sl-color-gray-6);
  }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.55rem;
    padding: 0;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  button:hover {
    color: var(--sl-color-white);
  }
  button[aria-pressed='true'] {
    background: var(--sh-accent-wash, color-mix(in oklab, var(--sl-color-accent) 14%, transparent));
    color: var(--sl-color-accent-high);
  }
  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
