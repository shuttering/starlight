{
  "name": "@shuttering/starlight",
  "version": "0.2.2",
  "description": "A Starlight docs theme cut from the shuttering contract \u2014 token-driven grounds + palettes, quiet and low-border.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/theme.css",
    "./grounds/*": "./src/grounds/*",
    "./palettes/*": "./src/palettes/*",
    "./ThemeSelect.astro": "./components/ThemeSelect.astro",
    "./Head.astro": "./components/Head.astro"
  },
  "files": [
    "src",
    "components"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.41.0",
    "astro": ">=5.0.0"
  },
  "keywords": [
    "starlight",
    "astro",
    "theme",
    "docs",
    "shuttering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuttering/starlight.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "lint": "biome check . --error-on-warnings",
    "format": "biome check --write .",
    "build:fixture": "astro build --root test/fixture",
    "test:contract": "vitest run test/contract.test.ts",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm test:contract && pnpm build:fixture && pnpm test"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.7",
    "@biomejs/biome": "2.5.8",
    "@shuttering/tokens": "1.0.0",
    "astro": "7.2.2",
    "jsdom": "30.0.1",
    "vitest": "4.1.10"
  }
}
