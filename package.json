{
  "name": "@shuttering/starlight",
  "version": "0.2.0",
  "description": "A Starlight docs theme cut from the shuttering contract — token-driven grounds + palettes, quiet and low-border.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/theme.css",
    "./grounds/*": "./src/grounds/*",
    "./palettes/*": "./src/palettes/*",
    "./ThemeSelect.astro": "./components/ThemeSelect.astro",
    "./Head.astro": "./components/Head.astro"
  },
  "files": [
    "src",
    "components"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.41.0",
    "astro": ">=5.0.0"
  },
  "keywords": [
    "starlight",
    "astro",
    "theme",
    "docs",
    "shuttering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuttering/starlight.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
