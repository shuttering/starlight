{
  "name": "@shuttering/starlight",
  "version": "0.1.0",
  "description": "A Starlight docs theme cut from the shuttering contract — token-driven grounds + palettes, quiet and low-border.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/theme.css",
