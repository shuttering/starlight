    "./palettes/*": "./src/palettes/*"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "starlight",
    "astro",
    "theme",
    "docs",
    "shuttering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuttering/starlight.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
